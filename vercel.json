{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "platform-admin": {
      "root": "apps/platform-admin",
      "framework": "nextjs"
    },
    "prop-admin": {
      "root": "apps/prop-admin",
      "framework": "nextjs"
    },
    "trader": {
      "root": "apps/trader",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "^/prop-admin(/.*)?$", "destination": { "service": "prop-admin" } },
    { "source": "^/platform-admin(/.*)?$", "destination": { "service": "platform-admin" } },
    { "source": "/(.*)", "destination": { "service": "trader" } }
  ]
}