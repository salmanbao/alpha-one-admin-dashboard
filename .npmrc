# Lifecycle scripts never run silently.
# Floor for npm/pnpm/yarn and for `bun install --ignore-scripts=false` overrides:
# bun additionally gates every package on root package.json "trustedDependencies"
# (currently [] = nothing is allow-listed; add a package name there to permit
# its pre/install/postinstall scripts, and drop ignore-scripts to false).
ignore-scripts=true

# Refuse installs when engines don't match the current runtime.
engine-strict=true
