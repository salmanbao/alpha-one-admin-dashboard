{
  "name": "pfaas-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node init && turbo run dev",
    "build": "node init && turbo run build",
    "build:prop-admin": "node init && turbo run build --filter=@pfaas/prop-admin",
    "lint": "turbo run lint",
    "lint:cross-app": "eslint apps"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "turbo": "^2.3.3"
  },
  "packageManager": "bun@1.1.20",
  "engines": {
    "node": ">=20",
    "bun": ">=1.2.0"
  },
  "trustedDependencies": []
}
