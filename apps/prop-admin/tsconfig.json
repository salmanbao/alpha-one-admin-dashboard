{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/lib/utils": [
        "../../packages/ui/src/lib/utils"
      ],
      "@/hooks/*": [
        "../../packages/ui/src/hooks/*"
      ],
      "@/components/ui/*": [
        "../../packages/ui/src/components/ui/*"
      ],
      "@/components/platform/dashboard-router": [
        "./src/components/platform/dashboard-router"
      ],
      "@/components/platform/providers": [
        "./src/components/platform/providers"
      ],
      "@/components/platform/contextual-actions": [
        "./src/components/platform/contextual-actions"
      ],
      "@/components/platform/payout-reject-dialog": [
        "./src/components/platform/payout-reject-dialog"
      ],
      "@/components/platform/detail-overlay": [
        "./src/components/platform/detail-overlay"
      ],
      "@/components/platform/platform-empty-state": [
        "./src/components/platform/platform-empty-state"
      ],
      "@/components/platform/*": [
        "../../packages/ui/src/components/platform/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "docs"
  ]
}
